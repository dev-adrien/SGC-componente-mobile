<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F8F9FA">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Importar Nota Fiscal"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tire uma foto ou selecione o arquivo da nota para cadastrar os produtos via IA."
        android:textSize="14sp"
        android:textColor="#6c757d"
        android:textAlignment="center"
        android:layout_marginBottom="40dp"/>

    <!-- Ícone ilustrativo -->
    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@android:drawable/ic_menu_camera"
        app:tint="#2E7D32"
        android:layout_marginBottom="32dp"/>

    <!-- Feedback do arquivo selecionado -->
    <TextView
        android:id="@+id/txtArquivoSelecionado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nenhum arquivo selecionado"
        android:textSize="14sp"
        android:textStyle="italic"
        android:textColor="#424242"
        android:layout_marginBottom="24dp"/>

    <!-- Botão para abrir o explorador de arquivos -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEscolherArquivo"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="SELECIONAR ARQUIVO"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        android:layout_marginBottom="16dp"/>

    <!-- Botão para enviar para o Gemini -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnProcessarNota"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="PROCESSAR COM IA"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:backgroundTint="#2E7D32"/>

</LinearLayout>