<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F8F9FA">

    <!-- Card simulando a etiqueta (conteúdo que pode ser exportado) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardEtiqueta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeWidth="1dp"
        app:strokeColor="#E0E0E0"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center">

            <TextView
                android:id="@+id/txtEtiquetaNome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nome do Produto"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginBottom="20dp"
                android:textAlignment="center"/>

            <ImageView
                android:id="@+id/imgCodigoBarras"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:scaleType="fitXY"
                android:layout_marginBottom="12dp"
                android:contentDescription="Código de Barras"/>

            <TextView
                android:id="@+id/txtEtiquetaId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CÓDIGO / ID"
                android:textSize="15sp"
                android:letterSpacing="0.15"
                android:textStyle="bold"
                android:textColor="#424242"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Botão de Salvar/Baixar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBaixarImagem"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="BAIXAR / SALVAR ETIQUETA"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:backgroundTint="#2E7D32"
        android:layout_marginTop="28dp"/>

    <!-- Botão de Voltar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVoltarEstoque"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="VOLTAR"
        android:textSize="15sp"
        android:textColor="#616161"
        app:strokeColor="#BDBDBD"
        app:cornerRadius="12dp"
        android:layout_marginTop="12dp"/>

</LinearLayout>